{
  "name": "baysor",
  "version-string": "0.8.3",
  "description": "C++ implementation of Baysor for imaging-based spatial transcriptomics segmentation.",
  "dependencies": [
    "eigen3",
    "spdlog",
    "cgal",
    {
      "name": "arrow",
      "default-features": false,
      "features": [
        "compute",
        "csv",
        "parquet"
      ]
    },
    {
      "name": "hdf5",
      "default-features": false,
      "features": [
        "zlib"
      ]
    },
    "nlohmann-json",
    "tiff"
  ],
  "features": {
    "tests": {
      "description": "Dependencies needed to build and run the C++ unit tests.",
      "dependencies": [
        "gtest"
      ]
    }
  }
}
