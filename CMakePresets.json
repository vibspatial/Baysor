{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "user",
      "displayName": "User Build",
      "description": "End-user build using dependencies already visible to CMake. Optimized, tests off, installs to ./install.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/user",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install",
        "BAYSOR_WITH_TESTS": "OFF"
      }
    },
    {
      "name": "tests",
      "displayName": "User Build With Tests",
      "description": "End-user build with the optional GTest-based test target.",
      "inherits": "user",
      "binaryDir": "${sourceDir}/build/tests",
      "cacheVariables": {
        "BAYSOR_WITH_TESTS": "ON"
      }
    },
    {
      "name": "user-vcpkg",
      "displayName": "User Build With vcpkg",
      "description": "End-user build with dependencies installed in user space through vcpkg manifest mode.",
      "inherits": "user",
      "binaryDir": "${sourceDir}/build/user-vcpkg",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      }
    },
    {
      "name": "vcpkg-tests",
      "displayName": "User Build With vcpkg And Tests",
      "description": "User-space dependency install through vcpkg, including GTest.",
      "inherits": "user-vcpkg",
      "binaryDir": "${sourceDir}/build/vcpkg-tests",
      "cacheVariables": {
        "BAYSOR_WITH_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "user",
      "configurePreset": "user",
      "targets": [
        "baysor"
      ]
    },
    {
      "name": "tests",
      "configurePreset": "tests",
      "targets": [
        "baysor",
        "baysor_tests"
      ]
    },
    {
      "name": "user-vcpkg",
      "configurePreset": "user-vcpkg",
      "targets": [
        "baysor"
      ]
    },
    {
      "name": "vcpkg-tests",
      "configurePreset": "vcpkg-tests",
      "targets": [
        "baysor",
        "baysor_tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "tests",
      "configurePreset": "tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vcpkg-tests",
      "configurePreset": "vcpkg-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
